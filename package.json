{
  "name": "react-native-x402-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run typecheck && node --experimental-strip-types --test packages/*/test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
